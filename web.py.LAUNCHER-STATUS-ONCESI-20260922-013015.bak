@routes.post(MOD_PATH + "/login")
async def moderator_login(request):
    data = await request.post()
    email = normalize_email(data.get("email"))
    password = data.get("password", "")
    uid = app["redis"].get("email:{}".format(email))
    if not uid:
        return json_result("E-posta veya şifre hatalı.", status=401)
    encoded = app["redis"].get("uid:{}:webpass".format(uid))
    if not encoded or not verify_password(password, encoded):
        return json_result("E-posta veya şifre hatalı.", status=401)
    role = int(app["redis"].get("uid:{}:role".format(uid)) or 0)
    if role not in (2, 4):
        return json_result("Bu hesabın moderatör paneline erişim yetkisi yok.", status=403)
    session = await aiohttp_session.get_session(request)
    session["moderator_admin"] = True
    session["moderator_uid"] = str(uid)
    session["moderator_role"] = role
    return web.json_response({"ok": True, "message": "Giriş başarılı.", "uid": str(uid),
                              "role": role,
                              "permissions": {"warn": moderator_can(session,"warn"),
                                              "mute": moderator_can(session,"mute"),
                                              "ban": moderator_can(session,"ban")}})

@routes.post(MOD_PATH + "/logout")
async def moderator_logout(request):
    session = await aiohttp_session.get_session(request)
    session["moderator_admin"] = False
    session.pop("moderator_uid", None)
    session.pop("moderator_role", None)
    return json_result("Oturum kapatıldı.", ok=True)


@routes.post(MOD_PATH + "/lookup")
async def moderator_lookup(request):
    import time
    session = await aiohttp_session.get_session(request)
    if not moderator_authorized(session):
        return json_result("Yetkisiz erişim.", status=403)
    data = await request.post()
    uid = (data.get("uid") or "").strip()
    if not uid.isdigit() or not player_exists(uid):
        return json_result("Oyuncu bulunamadı.", status=404)

    appearance = app["redis"].lrange("uid:{}:appearance".format(uid), 0, 0)
    name = appearance[0] if appearance else "İsimsiz"
    now = int(time.time())
    mute_until = int(app["redis"].get("uid:{}:mute_until".format(uid)) or 0)
    ban_until = int(app["redis"].get("uid:{}:ban_until".format(uid)) or 0)
    banned_by = app["redis"].get("uid:{}:banned".format(uid)) or ""
    email = app["redis"].get("uid:{}:email".format(uid)) or ""
    level = get_level(int(app["redis"].get("uid:{}:exp".format(uid)) or 0))
    online = bool(app["redis"].exists("uid:{}:online_presence".format(uid)))
    mute_reason = app["redis"].get("uid:{}:mute_reason".format(uid)) or ""
    ban_reason = app["redis"].get("uid:{}:ban_reason".format(uid)) or ""
    return web.json_response({
        "ok": True, "uid": uid, "name": name, "email": email,
        "level": level,
        "role": int(app["redis"].get("uid:{}:role".format(uid)) or 0),
        "online": online,
        "muted": mute_until == -1 or mute_until > now,
        "mute_until": mute_until, "mute_reason": mute_reason,
        "banned": bool(banned_by) and (ban_until == -1 or ban_until > now or ban_until == 0),
        "ban_until": ban_until, "ban_reason": ban_reason, "banned_by": banned_by
    })



@routes.post(MOD_PATH + "/search")
async def moderator_search(request):
    session = await aiohttp_session.get_session(request)
    if not moderator_authorized(session):
        return json_result("Yetkisiz erişim.", status=403)
    data = await request.post()
    q = (data.get("q") or "").strip().lower()
    if len(q) < 1:
        return web.json_response({"ok": True, "players": []})

    results = []
    seen = set()

    # UID ile dogrudan arama
    if q.isdigit() and player_exists(q):
        seen.add(q)
        results.append(q)

    # E-posta anahtarlari ve appearance listeleri uzerinden sinirli arama.
    # SCAN yerine cursor kullanilir; Redis'i tek istekte kilitlemez.
    cursor = 0
    checked = 0
    while True:
        cursor, keys = app["redis"].scan(cursor=cursor, match="uid:*:email", count=150)
        for key in keys:
            checked += 1
            parts = key.split(":")
            if len(parts) < 3:
                continue
            uid = parts[1]
            if uid in seen:
                continue
            email = (app["redis"].get(key) or "").lower()
            appearance = app["redis"].lrange("uid:{}:appearance".format(uid), 0, 0)
            name = (appearance[0] if appearance else "").lower()
            if q in uid.lower() or q in email or (name and q in name):
                seen.add(uid)
                results.append(uid)
                if len(results) >= 8:
                    break
        if len(results) >= 8 or cursor == 0 or checked >= 1500:
            break

    players = []
    now = int(time.time())
    for uid in results[:8]:
        appearance = app["redis"].lrange("uid:{}:appearance".format(uid), 0, 0)
        name = appearance[0] if appearance else "İsimsiz"
        mute_until = int(app["redis"].get("uid:{}:mute_until".format(uid)) or 0)
        ban_until = int(app["redis"].get("uid:{}:ban_until".format(uid)) or 0)
        banned_by = app["redis"].get("uid:{}:banned".format(uid)) or ""
        players.append({
            "uid": uid, "name": name,
            "level": get_level(int(app["redis"].get("uid:{}:exp".format(uid)) or 0)),
            "role": int(app["redis"].get("uid:{}:role".format(uid)) or 0),
            "online": bool(app["redis"].exists("uid:{}:online_presence".format(uid))),
            "muted": mute_until == -1 or mute_until > now,
            "banned": bool(banned_by) and (ban_until == -1 or ban_until > now or ban_until == 0)
        })
    return web.json_response({"ok": True, "players": players})


@routes.post(MOD_PATH + "/action")
async def moderator_action(request):
    import json, time
    session = await aiohttp_session.get_session(request)
    if not moderator_authorized(session):
        return json_result("Yetkisiz erişim.", status=403)
    data = await request.post()
    uid = (data.get("uid") or "").strip()
    action = (data.get("action") or "").strip()
    reason = (data.get("reason") or "").strip()
    if not moderator_can(session, action):
        return json_result("Oyun rolünün bu işlem için yetkisi yok.", status=403)
    moderator_uid = str(session.get("moderator_uid", "0"))
    moderator_role = int(session.get("moderator_role", 0) or 0)
    if not uid.isdigit() or not player_exists(uid):
        return json_result("Oyuncu bulunamadı.", status=404)

    role = int(app["redis"].get("uid:{}:role".format(uid)) or 0)
    if action in ("mute", "ban"):
        if moderator_role == 2 and role >= 2:
            return json_result("Moderatör başka bir yetkili hesaba ceza uygulayamaz.", status=403)
        if moderator_role == 4 and role >= 4:
            return json_result("Admin aynı veya daha yüksek yetkili hesaba ceza uygulayamaz.", status=403)

    now = int(time.time())
    if action in ("mute", "ban"):
        duration = (data.get("duration") or "").strip()
        if duration == "permanent":
            until = -1
        else:
            try:
                minutes = int(duration)
                if minutes < 1 or minutes > 525600:
                    raise ValueError
            except ValueError:
                return json_result("Geçerli bir ceza süresi seç.", status=400)
            until = now + minutes * 60

    if action == "mute":
        app["redis"].set("uid:{}:mute_until".format(uid), until)
        app["redis"].set("uid:{}:mute_reason".format(uid), reason)
        app["redis"].rpush("moderation:commands", json.dumps({"action":"mute","uid":uid,"until":until,"reason":reason,"moderator_uid":moderator_uid}, ensure_ascii=False))
        return json_result("Oyuncu susturuldu.", ok=True)

    if action == "unmute":
        app["redis"].delete("uid:{}:mute_until".format(uid), "uid:{}:mute_reason".format(uid))
        app["redis"].rpush("moderation:commands", json.dumps({"action":"unmute","uid":uid,"moderator_uid":moderator_uid}, ensure_ascii=False))
        return json_result("Susturma kaldırıldı.", ok=True)

    if action == "ban":
        app["redis"].set("uid:{}:banned".format(uid), moderator_uid)
        app["redis"].set("uid:{}:ban_time".format(uid), int(time.time()*1000))
        app["redis"].set("uid:{}:ban_until".format(uid), until)
        app["redis"].set("uid:{}:ban_reason".format(uid), reason)
        app["redis"].rpush("moderation:commands", json.dumps({"action":"ban","uid":uid,"until":until,"reason":reason,"moderator_uid":moderator_uid}, ensure_ascii=False))
        return json_result("Oyuncu banlandı. Çevrimiçiyse bağlantısı en geç sonraki kontrol/girişte engellenecek.", ok=True)

    if action == "unban":
        app["redis"].delete("uid:{}:banned".format(uid), "uid:{}:ban_time".format(uid),
                            "uid:{}:ban_until".format(uid), "uid:{}:ban_reason".format(uid))
        app["redis"].rpush("moderation:commands", json.dumps({"action":"unban","uid":uid,"moderator_uid":moderator_uid}, ensure_ascii=False))
        return json_result("Ban kaldırıldı.", ok=True)

    if action == "warn":
        if not reason:
            return json_result("Uyarı mesajı boş olamaz.", status=400)
        payload = json.dumps({"ts": now, "message": reason}, ensure_ascii=False)
        app["redis"].rpush("uid:{}:moderator_messages".format(uid), payload)
        app["redis"].ltrim("uid:{}:moderator_messages".format(uid), -20, -1)
        app["redis"].rpush("moderation:commands", json.dumps({"action":"warn","uid":uid,"message":reason,"moderator_uid":moderator_uid}, ensure_ascii=False))
        return json_result("Uyarı kuyruğa eklendi; oyuncuya oyun sunucusu üzerinden iletilecek.", ok=True)

    return json_result("Geçersiz işlem.", status=400)


@routes.get(MOD_PATH + "/logs")
async def moderator_logs(request):
    import json
    session = await aiohttp_session.get_session(request)
    if not moderator_authorized(session):
        return json_result("Yetkisiz erişim.", status=403)
    rows = []
    for raw in app["redis"].lrange(MOD_LOG_KEY, 0, 49):
        try:
            rows.append(json.loads(raw))
        except Exception:
            pass
    return web.json_response({"ok": True, "logs": rows})


@routes.get("/appconfig.xml")
async def appconfig(request):
    session = await aiohttp_session.get_session(request)

    if "token" not in session or "uid" not in session:
        raise web.HTTPUnauthorized()

    context = {
        "token": session["token"],
        "uid": session["uid"],
        "ip": config["webserver"]["server_ip"],
        "address": config["webserver"]["web_address"]
    }
    return aiohttp_jinja2.render_template(
        "appconfig.xml",
        request,
        context=context
    )


@routes.get("/crossdomain.xml")
async def crossdomain(request):
    return web.Response(
        text=CROSSDOMAIN_XML,
        content_type="application/xml"
    )


async def main():
    global app

    app = web.Application()
    app.add_routes(routes)
    app["redis"] = redis.Redis(decode_responses=True)

    fernet_key = fernet.Fernet.generate_key()
    secret_key = base64.urlsafe_b64decode(fernet_key)
    aiohttp_session.setup(
        app,
        EncryptedCookieStorage(secret_key)
    )

    aiohttp_jinja2.setup(
        app,
        loader=jinja2.FileSystemLoader("templates")
    )

    runner = web.AppRunner(app)
    await runner.setup()

    site = web.TCPSite(
        runner,
        "192.168.1.104",
        int(config["webserver"]["web_port"])
    )
    await site.start()


if __name__ == "__main__":
    loop = asyncio.get_event_loop()
    loop.create_task(main())
    loop.run_forever()
