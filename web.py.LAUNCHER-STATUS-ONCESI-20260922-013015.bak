@routes.post(PANEL_PATH + "/login")
async def admin_panel_login(request):
    data = await request.post()
    if not secrets.compare_digest(data.get("password", ""), PANEL_PASSWORD):
        return json_result("Panel şifresi hatalı.", status=401)

    session = await aiohttp_session.get_session(request)
    session["panel_admin"] = True
    return json_result("Giriş başarılı.", ok=True)


@routes.post(PANEL_PATH + "/lookup")
async def admin_panel_lookup(request):
    session = await aiohttp_session.get_session(request)
    if not panel_authorized(session):
        return json_result("Yetkisiz erişim.", status=403)

    data = await request.post()
    uid = (data.get("uid") or "").strip()
    if not uid.isdigit():
        return json_result("Geçerli bir UID gir.", status=400)

    # Hesabın varlığını birkaç temel Redis anahtarı üzerinden doğrula.
    exists = (
        app["redis"].exists("uid:{}:gld".format(uid))
        or app["redis"].exists("uid:{}:exp".format(uid))
        or app["redis"].exists("uid:{}:email".format(uid))
    )
    if not exists:
        return json_result("Bu UID bulunamadı.", status=404)

    values = {}
    for field in PANEL_FIELDS:
        value = app["redis"].get("uid:{}:{}".format(uid, field))
        values[field] = "" if value is None else value

    current_exp = int(values.get("exp") or 0)
    return web.json_response({
        "ok": True,
        "uid": uid,
        "email": app["redis"].get("uid:{}:email".format(uid)) or "",
        "values": values,
        "level": get_level(current_exp)
    })


@routes.post(PANEL_PATH + "/save")
async def admin_panel_save(request):
    session = await aiohttp_session.get_session(request)
    if not panel_authorized(session):
        return json_result("Yetkisiz erişim.", status=403)

    data = await request.post()
    uid = (data.get("uid") or "").strip()
    if not uid.isdigit():
        return json_result("Geçerli bir UID gir.", status=400)

    numeric_fields = {"gld", "slvr", "exp", "enrg", "crt", "hrt"}
    pipe = app["redis"].pipeline()

    for field in PANEL_FIELDS:
        if field not in data:
            continue

        value = (data.get(field) or "").strip()
        key = "uid:{}:{}".format(uid, field)

        if value == "":
            # Boş bırakılan değer mevcut Redis değerini silmez.
            continue

        if field in numeric_fields:
            try:
                numeric_value = int(value)
            except ValueError:
                return json_result("{} sayısal olmalı.".format(field), status=400)

            if field == "exp":
                if numeric_value < 1 or numeric_value > 1000:
                    return json_result("Seviye 1 ile 1000 arasında olmalı.", status=400)
                value = str(exp_for_level(numeric_value))

        pipe.set(key, value)

    pipe.execute()
    return json_result("UID {} güncellendi.".format(uid), ok=True)


