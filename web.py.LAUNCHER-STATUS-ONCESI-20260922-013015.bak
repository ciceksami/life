MOD_LOG_KEY = "moderation:logs"



def panel_authorized(session):
    return session.get("panel_admin") is True

def moderator_authorized(session):
    try:
        return int(session.get("moderator_role", 0)) in (2, 4)
    except (TypeError, ValueError):
        return False

def moderator_can(session, action):
    try:
        role = int(session.get("moderator_role", 0))
    except (TypeError, ValueError):
        return False
    if role == 2:
        return action in ("mute", "unmute", "warn")
    if role == 4:
        return action in ("mute", "unmute", "warn", "ban", "unban")
    return False


def moderation_log(action, uid, detail=""):
    import json, time
    entry = {
        "ts": int(time.time()),
        "action": action,
        "uid": str(uid),
        "detail": str(detail)[:500]
    }
    app["redis"].lpush(MOD_LOG_KEY, json.dumps(entry, ensure_ascii=False))
    app["redis"].ltrim(MOD_LOG_KEY, 0, 199)


def player_exists(uid):
    return bool(
        app["redis"].exists("uid:{}:gld".format(uid))
        or app["redis"].exists("uid:{}:exp".format(uid))
        or app["redis"].exists("uid:{}:email".format(uid))
        or app["redis"].exists("uid:{}:appearance".format(uid))
    )


def exp_for_level(level):
    """get_level() fonksiyonunda tam olarak bu seviyeyi gosteren minimum EXP."""
    if level < 1:
        raise ValueError("Seviye en az 1 olmali.")
    return 25 * (level - 1) * level


def hash_password(password):
    iterations = 120000
    salt = secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac(
        "sha256",
        password.encode("utf-8"),
        salt,
        iterations
    )
    return "pbkdf2_sha256${}${}${}".format(
        iterations,
        salt.hex(),
        digest.hex()
    )


def verify_password(password, encoded):
    try:
        algorithm, iterations, salt_hex, digest_hex = encoded.split("$", 3)
        if algorithm != "pbkdf2_sha256":
            return False

        actual = hashlib.pbkdf2_hmac(
            "sha256",
            password.encode("utf-8"),
            bytes.fromhex(salt_hex),
            int(iterations)
        )
        expected = bytes.fromhex(digest_hex)
        return secrets.compare_digest(actual, expected)
    except (ValueError, TypeError):
        return False


def normalize_email(value):
    return (value or "").strip().lower()


def json_result(message, status=200, ok=False, refresh_captcha=None):
    payload = {
        "ok": ok,
        "message": message
    }
    if refresh_captcha is not None:
        payload["refresh_captcha"] = refresh_captcha
    return web.json_response(payload, status=status)


def find_game_token(uid):
    uid = str(uid)
    for key in app["redis"].scan_iter(match="auth:*", count=100):
        if app["redis"].get(key) == uid:
            return key[5:]
    return None


def new_captcha():
    return str(secrets.randbelow(900000) + 100000)


def make_captcha_svg(code):
    safe_code = html.escape(code)
    positions = [24, 64, 104, 144, 184, 224]
    chars = []

    for i, ch in enumerate(safe_code):
        angle = secrets.choice(range(-11, 12))
        y = secrets.choice(range(40, 51))
        chars.append(
            '<text x="{0}" y="{1}" transform="rotate({2} {0} {1})">{3}</text>'
            .format(positions[i], y, angle, ch)
        )

    lines = []
    for _ in range(8):
        x1 = secrets.choice(range(4, 246))
        y1 = secrets.choice(range(7, 58))
        x2 = secrets.choice(range(4, 246))
        y2 = secrets.choice(range(7, 58))
        lines.append(
            '<line x1="{}" y1="{}" x2="{}" y2="{}"/>'
            .format(x1, y1, x2, y2)
        )

    dots = []
    for _ in range(20):
        cx = secrets.choice(range(5, 246))
        cy = secrets.choice(range(5, 60))
        r = secrets.choice([1, 1, 1, 2])
        dots.append('<circle cx="{}" cy="{}" r="{}"/>'.format(cx, cy, r))

    return """<svg xmlns="http://www.w3.org/2000/svg" width="250" height="64" viewBox="0 0 250 64">
      <defs>
        <linearGradient id="bg" x1="0" x2="1">
          <stop offset="0" stop-color="#110820"/>
          <stop offset="1" stop-color="#241039"/>
        </linearGradient>
      </defs>
      <rect width="250" height="64" rx="10" fill="url(#bg)"/>
      <g stroke="#bd6cff" stroke-width="1" opacity=".24">{lines}</g>
      <g fill="#b768ff" opacity=".18">{dots}</g>
      <g fill="#ffffff" font-family="Arial,sans-serif" font-size="27"
         font-weight="900" text-anchor="middle"
         style="paint-order:stroke;stroke:#6c2ca4;stroke-width:1px">{chars}</g>
    </svg>""".format(
        lines="".join(lines),
        dots="".join(dots),
        chars="".join(chars)
    )


def get_level(exp):
    exp_sum = 0
    level = 0
    while exp_sum <= exp:
        level += 1
        exp_sum += level * 50
    return level


@routes.get("/")
async def index(request):
    session = await aiohttp_session.get_session(request)
    context = {
        "logged_in": False,
        "registration_enabled": REGISTRATION_ENABLED
    }

    if session.get("token") and session.get("uid"):
        uid = str(session["uid"])

        def redis_int(key, default=0):
            value = app["redis"].get(key)
            try:
                return int(value) if value is not None else default
            except (TypeError, ValueError):
                return default

        exp = redis_int("uid:{}:exp".format(uid))

        context.update({
            "logged_in": True,
            "token": session["token"],
            "uid": uid,
            "email": app["redis"].get("uid:{}:email".format(uid)) or "Oyuncu",
            "level": get_level(exp),
            "silver": redis_int("uid:{}:slvr".format(uid)),
            "gold": redis_int("uid:{}:gld".format(uid)),
            "energy": redis_int("uid:{}:enrg".format(uid)),
            "update_time": config["webserver"]["update_time"]
        })

    return aiohttp_jinja2.render_template(
        "index.html",
        request,
        context=context
    )


@routes.post("/login")
async def login(request):
    data = await request.post()

    email = normalize_email(data.get("email"))
    password = data.get("password", "")

    if not email or not password:
        return json_result(
            "E-posta ve şifre alanlarını doldur.",
            status=400
        )

    if not EMAIL_RE.match(email):
        return json_result(
            "Geçerli bir e-posta adresi gir.",
            status=400
        )

    uid = app["redis"].get("email:{}".format(email))

    # Account enumeration is intentionally avoided.
    if not uid:
        return json_result(
            "E-posta adresi veya şifre hatalı.",
            status=401
        )

    stored = app["redis"].get("uid:{}:webpass".format(uid))
    if not stored or not verify_password(password, stored):
        return json_result(
            "E-posta adresi veya şifre hatalı.",
            status=401
        )

    game_token = find_game_token(uid)
    if not game_token:
        return json_result(
            "Oyun hesabı doğrulanamadı. Yöneticiyle iletişime geç.",
            status=500
        )

    session = await aiohttp_session.new_session(request)
    session["uid"] = str(uid)
    session["token"] = game_token

    return json_result(
        "Giriş başarılı. Avatar Life hazırlanıyor...",
        ok=True
    )


@routes.get("/captcha")
async def captcha(request):
    session = await aiohttp_session.get_session(request)

    # Basit 6 haneli rastgele sayı.
    code = new_captcha()
    session["captcha"] = code

    response = web.json_response({
        "ok": True,
        "code": code
    })
    response.headers["Cache-Control"] = "no-store, no-cache, must-revalidate, max-age=0"
    response.headers["Pragma"] = "no-cache"
    response.headers["Expires"] = "0"
    return response


@routes.post("/register")
async def register_account(request):
    if not REGISTRATION_ENABLED:
        return json_result(
            "Kayıt sistemi şu anda kapalı.",
            status=403,
            refresh_captcha=False
        )

    data = await request.post()

    email = normalize_email(data.get("email"))
    password = data.get("password", "")
    password_repeat = data.get("password_repeat", "")
    captcha_value = (data.get("captcha") or "").strip()

    if not EMAIL_RE.match(email):
        return json_result(
            "Geçerli bir e-posta adresi gir.",
            status=400,
            refresh_captcha=False
        )

    if len(password) < 6:
        return json_result(
            "Şifre en az 6 karakter olmalı.",
            status=400,
            refresh_captcha=False
        )

    if len(password) > 128:
        return json_result(
            "Şifre çok uzun.",
            status=400,
            refresh_captcha=False
        )

    if password != password_repeat:
        return json_result(
            "Şifreler birbiriyle aynı değil.",
            status=400,
            refresh_captcha=False
        )

    if not CAPTCHA_RE.match(captcha_value):
        return json_result(
            "Doğrulama kodu 6 haneli olmalı.",
            status=400,
            refresh_captcha=True
        )

    session = await aiohttp_session.get_session(request)
    expected = session.get("captcha", "")
    session["captcha"] = ""

    if not expected or not secrets.compare_digest(captcha_value, expected):
        return json_result(
            "Doğrulama kodu yanlış. Yeni kod oluşturuldu.",
            status=400,
            refresh_captcha=True
        )

    if app["redis"].exists("email:{}".format(email)):
        return json_result(
            "Bu e-posta adresi zaten kayıtlı.",
            status=409,
            refresh_captcha=True
        )

    uid, game_token = utils.bot_common.new_account(app["redis"])

    # Yeni hesap baslangic degerleri:
    # get_level() hesabina gore 39.000 EXP = Level 40.
    app["redis"].set("uid:{}:gld".format(uid), 25000)
    app["redis"].set("uid:{}:exp".format(uid), 39000)

    pipe = app["redis"].pipeline()
    pipe.set("email:{}".format(email), uid)
    pipe.set("uid:{}:email".format(uid), email)
    pipe.set("uid:{}:webpass".format(uid), hash_password(password))
    pipe.execute()

    return json_result(
        "Hesabın başarıyla oluşturuldu. Şimdi giriş yapabilirsin.",
        ok=True,
        refresh_captcha=False
    )


@routes.get("/logout")
async def logout(request):
    session = await aiohttp_session.get_session(request)

    # Oturumu kesin olarak geçersiz kıl.
    try:
        session.invalidate()
    except AttributeError:
        session.clear()

    response = web.HTTPFound("/?logged_out=1")
    # EncryptedCookieStorage varsayılan cookie adı.
    response.del_cookie("AIOHTTP_SESSION", path="/")
    response.headers["Cache-Control"] = "no-store, no-cache, must-revalidate, max-age=0"
    response.headers["Pragma"] = "no-cache"
    response.headers["Expires"] = "0"
    return response


